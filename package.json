{
  "name": "ts-package-template",
  "version": "1.0.0",
  "description": "A template for TypeScript packages",
  "author": "Seb Aebischer",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seb-cr/ts-package-template.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepare": "echo Cleaning && npm run clean && echo Building && npm run build && echo Done",
    "build": "tsc -p tsconfig-build.json",
    "clean": "rm -rf dist",
    "lint": "eslint src tests",
    "test": "mocha 'tests/**/*.spec.ts'",
    "coverage": "nyc npm test"
  },
  "devDependencies": {
    "@comicrelief/eslint-config": "^2.0.3",
    "@istanbuljs/esm-loader-hook": "^0.2.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@octokit/rest": "^22.0.1",
    "@types/chai": "^5.2.3",
    "@types/inquirer": "^9.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "chai": "^6.2.2",
    "chalk": "^5.6.2",
    "es-main": "^1.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^39.9.1",
    "inquirer": "^9.3.8",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
